# 默认无需创建 .env；以下配置仅在需要覆盖默认值时使用。

# 启用局域网访问时设为 0.0.0.0。
PROCESSPILOT_HOST=127.0.0.1
PROCESSPILOT_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
PROCESSPILOT_DEBUG=1
PROCESSPILOT_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5176,http://localhost:5176
PROCESSPILOT_REQUIRE_AUTH=0
PROCESSPILOT_SIMPLEUI=1
# Agent Runtime：legacy、hybrid（默认）或 skill_runtime。
AGENT_RUNTIME_MODE=hybrid
# CI/生产可把所有流水线与 Skill 运行产物放入独立持久卷或临时目录。
# PROCESSPILOT_RUNTIME_ROOT=/var/lib/processpilot/runtime
# PROCESSPILOT_MAX_CSV_ROWS=1000000
# PROCESSPILOT_MAX_CSV_COLUMNS=500
# 生产环境必须设置为独立随机值，且不要提交真实值。
# PROCESSPILOT_SECRET_KEY=
# 生产环境建议：DEBUG=0、REQUIRE_AUTH=1，并在 HTTPS 反向代理后启用下列配置。
# PROCESSPILOT_SECURE_SSL_REDIRECT=1
# PROCESSPILOT_HSTS_SECONDS=31536000
# PROCESSPILOT_ALLOWED_HOSTS=processpilot.example.com

# 默认使用 SQLite。
APC_DB_ENGINE=sqlite
APC_SQLITE_NAME=apc_agent.db

# 如需切换 MySQL，取消下列配置的注释并填写真实值。
# APC_DB_ENGINE=mysql
# APC_DB_NAME=apc_agent
# APC_DB_USER=root
# APC_DB_PASSWORD=
# APC_DB_HOST=127.0.0.1
# APC_DB_PORT=3306
