{
  "scenario_id": "vapor_pressure_soft_sensor",
  "scenario_name": "蒸气压力软测量实验",
  "industry": "流程工业实验装置",
  "process_unit": "再沸与冷凝压力估计",
  "version": "1.0.0",
  "dictionary": "fields.csv",
  "keywords": ["vapor pressure", "vapour pressure", "antoine estimate", "蒸气压", "再沸器"],
  "sampling_seconds": 3600,
  "time_axis_type": "elapsed_hours",
  "timestamp_field": "timestamp",
  "time_derivation": {
    "source_field": "hours_elapsed",
    "unit": "h",
    "origin": "2000-01-01T00:00:00",
    "physical_time_claim": "relative_only"
  },
  "primary_output": "vapour_pressure_kpa",
  "recognition": {
    "required_features": ["hours_elapsed", "reboiler_temperature_average", "condenser_pressure_inverse", "antoine_pressure_estimate", "current_pressure_estimate", "vapour_pressure_kpa"],
    "supporting_features": ["temperature_01", "temperature_04", "temperature_10", "valve_output_01", "flow_01", "pressure_01", "analyzer_01", "reboiler_temperature_rise"],
    "conflicting_features": ["bottom_butane_content", "boiler_outlet_steam_temperature", "energy_usage", "hot_metal_si"],
    "priority": 75,
    "minimum_evidence": 6,
    "minimum_confidence": 0.58,
    "minimum_required_field_coverage": 0.80
  },
  "source": {"dataset": "user-provided vapor-pressure.csv", "provenance_status": "needs_source_metadata"},
  "algorithm_profile": {
    "version": "1.0.0",
    "validation_status": "validated_on_sparse_lab_target",
    "selection": {
      "window_samples": 96,
      "step_samples": 24,
      "strict_score": 80,
      "usable_score": 50,
      "snr_db": 10,
      "allow_usable_fallback": true,
      "acceptance_mode": "sparse_target_adaptive",
      "sparse_output": true,
      "minimum_output_observations": 1,
      "modeling_top_k": 80,
      "min_valid_samples": 15,
      "score_weights": {"input_change": 0.45, "output_response": 0.10, "completeness": 0.20, "anomaly": 0.10, "smoothness": 0.15},
      "score_scales": {"input_change": 1200, "output_response": 900}
    },
    "decoupling": {
      "max_lag_samples": 72,
      "correlation_threshold": 0.90,
      "vif_threshold": 10,
      "model_families": ["FIRX"],
      "orders": [1],
      "ridge_alphas": [1, 10, 100],
      "max_features": 12,
      "target_observation_mode": "sparse_lab"
    },
    "optimization": {
      "objective_weights": {"r2": 0.68, "error": 0.17, "coverage": 0.15},
      "bounds": {"top_k": {"min": 20, "max": 100}, "max_lag": {"min": 12, "max": 72}},
      "constraints": {"min_r2": 0, "min_coverage": 0.05},
      "candidates": [
        {"round": 1, "top_k": 80, "max_lag": 48, "label": "稀疏化验覆盖基线"},
        {"round": 2, "top_k": 60, "max_lag": 24, "label": "短时滞软测量"},
        {"round": 3, "top_k": 100, "max_lag": 72, "label": "扩大化验目标覆盖"},
        {"round": 4, "top_k": 70, "max_lag": 36, "label": "中等时滞稳健辨识"},
        {"round": 5, "top_k": 90, "max_lag": 60, "label": "长时滞覆盖优先"},
        {"round": 6, "top_k": 50, "max_lag": 12, "label": "低维快速响应"}
      ]
    }
  },
  "notes": "根据真实文件字段结构登记。累计小时用于派生相对时间轴，不宣称绝对日历时间；实测蒸气压力按稀疏化验目标处理，缺失目标不插值。温度按摄氏度、目标压力按kPa解释；flow/pres原始通道单位仍需数据提供方确认。"
}
