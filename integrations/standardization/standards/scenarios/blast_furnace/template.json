      "lower_pressure_drop",
      "top_gas_pressure",
      "hot_blast_temperature",
      "top_gas_co2",
      "top_gas_h2",
      "top_gas_temp_1",
      "top_gas_temp_2",
      "top_gas_temp_3",
      "top_gas_temp_4",
      "peripheral_gas_temp_1",
      "peripheral_gas_temp_2",
      "peripheral_gas_temp_3",
      "peripheral_gas_temp_4",
      "peripheral_gas_temp_5",
      "peripheral_gas_temp_6",
      "peripheral_gas_temp_7",
      "peripheral_gas_temp_8",
      "peripheral_gas_temp_9",
      "peripheral_gas_temp_10",
