{
  "scenario_id": "blast_furnace",
  "scenario_name": "钢铁高炉铁水质量预测",
  "industry": "钢铁冶金",
  "process_unit": "炼铁高炉",
  "version": "1.1.0",
  "dictionary": "fields.csv",
  "keywords": [
    "钢铁高炉",
    "炼铁高炉",
    "高炉",
    "铁水",
    "铁水硅含量",
    "blast furnace",
    "hot metal",
    "silicon content"
  ],
  "sampling_seconds": 3600,
  "timestamp_field": "timestamp",
  "primary_output": "hot_metal_si",
  "recommended_max_lag": 24,
  "alignment_policy": "causal_asof_backward",
  "lab_tolerance_hours": 3,
  "algorithm_profile": {
    "version": "1.0.0",
    "validation_status": "engineering_baseline_pending_real_data_acceptance",
    "selection": {
      "window_samples": 24,
      "step_samples": 6,
      "strict_score": 75,
      "usable_score": 55,
      "snr_db": 6,
      "allow_usable_fallback": true,
      "acceptance_mode": "small_sample_adaptive",
      "min_valid_samples": 18,
      "score_weights": {"input_change": 0.25, "output_response": 0.30, "completeness": 0.25, "anomaly": 0.10, "smoothness": 0.10},
      "score_scales": {"input_change": 900, "output_response": 1200}
    },
    "decoupling": {
      "max_lag_samples": 12,
      "correlation_threshold": 0.92,
      "vif_threshold": 12,
      "model_families": ["ARX", "AR"],
      "orders": [1, 2],
      "ridge_alphas": [0, 1, 10]
    },
    "optimization": {
      "objective_weights": {"r2": 0.65, "error": 0.15, "coverage": 0.20},
      "bounds": {"top_k": {"min": 2, "max": 12}, "max_lag": {"min": 4, "max": 24}},
      "constraints": {"min_r2": 0, "min_coverage": 0.08},
      "candidates": [
        {"round": 1, "top_k": 5, "max_lag": 12, "label": "12小时基础时滞"},
        {"round": 2, "top_k": 3, "max_lag": 6, "label": "高质量短时滞"},
        {"round": 3, "top_k": 8, "max_lag": 18, "label": "扩大动态覆盖"},
        {"round": 4, "top_k": 10, "max_lag": 24, "label": "全天时滞上界"},
        {"round": 5, "top_k": 6, "max_lag": 9, "label": "中等覆盖稳健辨识"},
        {"round": 6, "top_k": 4, "max_lag": 15, "label": "化验滞后敏感性"}
      ]
    }
  },
  "source": {
    "dataset": "Process data collected by blast-furnace sensors",
    "author": "Vladimir Trofimov",
    "version": "1",
    "doi": "10.17632/6d7jbc7tb5.1",
    "license": "CC BY 4.0"
  },
  "notes": "真实高炉过程量为1小时采样，铁水Si为非等间隔化验值。派生CSV只允许向后as-of对齐，并保留化验时间与数据龄期，禁止使用未来化验值。",
  "family": "钢铁冶金",
  "field_roles": {
    "timestamp": "timestamp",
    "inputs": [
      "blast_flow_rate",
      "hot_blast_pressure",
      "cold_blast_pressure",
      "cold_blast_temperature",
      "oxygen_flow_rate",
      "total_pressure_drop",
