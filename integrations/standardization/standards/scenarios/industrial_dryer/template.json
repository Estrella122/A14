    "product_moisture",
    "product_temperature",
    "exhaust_humidity"
  ],
  "selection_window_samples": 18,
  "selection_step_samples": 6,
  "recognition": {
    "priority": 60,
    "min_evidence": 3,
    "min_confidence": 0.52,
