{
  "scenario_id": "industrial_dryer",
  "scenario_name": "工业干燥器",
  "industry": "流程工业",
  "process_unit": "连续式热风工业干燥装置",
  "version": "1.0.0",
  "dictionary": "fields.csv",
  "keywords": [
