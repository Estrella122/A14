{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A14 Industrial Scenario Template",
  "type": "object",
  "required": ["scenario_id", "scenario_name", "industry", "process_unit", "version", "dictionary", "keywords", "sampling_seconds", "timestamp_field", "primary_output", "notes"],
  "additionalProperties": false,
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "scenario_name": {"type": "string"},
    "industry": {"type": "string"},
    "process_unit": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dictionary": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.csv$"},
    "keywords": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sampling_seconds": {"type": ["integer", "null"], "minimum": 1},
    "timestamp_field": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "primary_output": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "model_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
    "selection_window_samples": {"type": "integer", "minimum": 10},
    "selection_step_samples": {"type": "integer", "minimum": 1},
    "time_axis_type": {"type": "string", "enum": ["wall_clock", "relative", "ordered_samples", "elapsed_hours"]},
    "data_provenance_required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recognition": {"type": "object"},
    "recommended_max_lag": {"type": ["integer", "null"], "minimum": 0},
    "alignment_policy": {"type": ["string", "null"]},
    "lab_tolerance_hours": {"type": ["number", "null"], "minimum": 0},
    "measurement_delay_minutes": {"type": ["number", "object", "null"], "minimum": 0},
    "expected_rows": {"type": ["integer", "null"], "minimum": 1},
    "source": {"type": ["string", "object", "null"]},
    "notes": {"type": "string"}
  }
}
